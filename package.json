{
  "name": "delhi-canteen-billing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node server/dev.mjs",
    "dev:vite": "vite",
    "dev:api": "node server/server.js",
    "desktop": "npm run build && electron electron/main.cjs",
    "build": "vite build",
    "dist:win": "npm run build && electron-builder --win portable",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "latest",
    "electron": "^44.3.0",
    "electron-builder": "^24.13.3",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "recharts": "latest",
    "vite": "latest",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "com.delhicanteen.billing",
    "compression": "store",
    "productName": "DelhiCanteen Software",
    "executableName": "DelhiCanteen Software",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "server",
        "to": "server"
      }
    ],
    "win": {
      "target": "portable",
      "artifactName": "DelhiCanteen Software.exe",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9"
  }
}
